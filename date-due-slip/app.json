{
  "expo": {
    "name": "Реченець",
    "slug": "date-due-slip",
    "scheme": "datedueslip",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F0E6"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Реченець to scan ISBN barcodes on book covers.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Реченець to attach book photos when adding a book manually.",
          "cameraPermission": "Allow Реченець to photograph books when adding them manually."
        }
      ]
    ],
    "android": {
      "package": "com.bookworms.datedueslip",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F0E6"
      }
    },
    "ios": {
      "bundleIdentifier": "com.bookworms.datedueslip",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Реченець to scan ISBN barcodes and photograph books.",
        "NSPhotoLibraryUsageDescription": "Allow Реченець to attach book photos from your library.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "extra": {
      "apiUrl": "http://192.168.0.213:18088"
    }
  }
}
