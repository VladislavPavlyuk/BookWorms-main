POSTGRES_DB=bookworms
POSTGRES_USER=bookworms
POSTGRES_PASSWORD=change-me-now

DJANGO_SECRET_KEY=replace-with-long-random-string
DEBUG=0
ALLOWED_HOSTS=192.168.0.213,localhost,127.0.0.1,api,datedueslip.com
CSRF_TRUSTED_ORIGINS=http://192.168.0.213:18088,http://datedueslip.com,https://datedueslip.com
PUBLIC_BASE_URL=http://192.168.0.213:18088
SKIP_EMAIL_ACTIVATION=0
ACTIVATION_TIMEOUT_MINUTES=5
WEB3FORMS_ACCESS_KEY=d76edac5-49fd-4574-b89b-45e24170aeab
DEFAULT_LOAN_DAYS=14
TIME_ZONE=Europe/Kyiv

# ISBN metadata (order = CSV). ISBNdb: https://isbndb.com/apidocs/v2
# Key goes in Authorization header (ISBNDB_API_KEY). LT often CF-blocked from NAS.
LIBRARYTHING_API_KEY=58aefacea1f37e153791c1cd58475558
ISBNDB_API_KEY=
GOOGLE_BOOKS_API_KEY=
BOOK_METADATA_PROVIDERS=openlibrary,isbndb,googlebooks,librarything

# Cover OCR (manual add → title / authors / ISBN from photo)
# Primary: https://ocr.space/ocrapi — free key, 1 MB/image, Engine 2 recommended
# Cover OCR — MUST be in project-root .env (same file compose uses: `env_file: .env`)
#   cp deploy/qnap/.env.example .env   # then set the key below
# DO NOT rely on .env.example alone — Django/compose never load *.example.
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
# auto + Engine 3: Cyrillic (ukr/rus) and Latin on the same cover
OCR_SPACE_LANGUAGE=auto
OCR_SPACE_ENGINE=3
# Optional fallback if OCR text is empty:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini

# Обов’язково SKIP_EMAIL_ACTIVATION=0, інакше юзери одразу is_active=True
# і purge їх ніколи не видалить.
# CSRF: порт має збігатися з тим, що в браузері (18088), + домен якщо є.

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@local
DJANGO_SUPERUSER_PASSWORD=change-admin-password
